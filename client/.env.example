# You do NOT need this file to run the project.
#
# Both variables below already default to these exact values, which match the
# database that `docker compose up -d` starts. Copy this to `.env` only if you
# need to override them - a different port, or a Postgres you manage yourself.

# PostgreSQL connection string, used by the API route handlers and the
# migrate/seed scripts.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feeding_brennen

# Base URL the frontend uses to reach this app's own API route handlers.
# It's the same origin as the app; only change it if you run on a different port.
NEXT_PUBLIC_API_URL=http://localhost:3000
